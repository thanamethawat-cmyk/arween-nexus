# PostgreSQL. docker compose sets this for the app container.
DATABASE_URL=postgres://arween:arween@127.0.0.1:5432/arween

# Nebius Token Factory, OpenAI-compatible. Leave blank for demo mode.
# Create a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Verified against the public catalog on 18 Oct 2026:
# https://tokenfactory.nebius.com/api/public/models_info
NEBIUS_EXTRACT_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_EXPLAIN_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Used when Ultra errors or the hallucination validator rejects the explanation.
NEBIUS_EXPLAIN_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL

# Tavily search. Leave blank to mark the check "not verified" with no invented result.
# The same query calls Tavily as soon as this key is set.
TAVILY_API_KEY=

# Public-demo abuse limits. Defaults protect a $25 Token Factory balance.
# A normal text review is about $0.005. The daily spend cap is $0.30.
# One Nemotron HTTP call is refused when the estimated cost would cross the cap.
# DEMO_DAILY_CALL_CAP overrides DEMO_DAILY_NEMOTRON_CALLS when both are set.
# DEMO_DAILY_BUDGET_USD overrides DEMO_DAILY_USD_MICROS when both are set.
# Raise those two on Vercel for the judging window (1–15 December 2026) if you want a higher public quota.
DEMO_MAX_UPLOAD_BYTES=8388608
DEMO_MAX_PASTE_CHARS=200000
DEMO_RATE_LIMIT_PER_MINUTE=6
DEMO_MUTATION_RATE_LIMIT_PER_MINUTE=30
DEMO_DAILY_CALL_CAP=80
DEMO_DAILY_NEMOTRON_CALLS=80
DEMO_IP_DAILY_NEMOTRON_CALLS=30
DEMO_DAILY_BUDGET_USD=0.30
DEMO_DAILY_USD_MICROS=300000

# Optional Postgres pool size per process. Use a small pool on serverless.
PG_POOL_MAX=3
